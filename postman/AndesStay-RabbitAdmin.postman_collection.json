        {
          "name": "6. Eliminar binding",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rabbit/bindings?exchange=demo.direct&destination=demo.q&destinationType=QUEUE&routingKey=demo.key",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rabbit",
                "bindings"
              ],
              "query": [
                {
                  "key": "exchange",
                  "value": "demo.direct"
                },
                {
                  "key": "destination",
                  "value": "demo.q"
                },
                {
                  "key": "destinationType",
                  "value": "QUEUE"
                },
                {
                  "key": "routingKey",
                  "value": "demo.key"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Eliminar cola demo.q",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rabbit/queues/demo.q",
              "host": [
                "{{baseUrl}}"
