{
  "info": {
    "name": "AndesStay - RabbitMQ Admin (EP3)",
    "description": "Pruebas de ms-andesstay-rabbit-admin (puerto 8086). Pega tu token (sin la palabra Bearer) en la variable 'token' de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086"
    },
    {
      "key": "token",
      "value": "PEGA_AQUI_TU_TOKEN"
    }
  ],
  "item": [
    {
      "name": "A. Flujo correcto (en orden)",
      "item": [
        {
          "name": "1. Crear exchange demo.direct",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rabbit/exchanges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rabbit",
                "exchanges"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"demo.direct\",\n  \"type\": \"DIRECT\",\n  \"durable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Crear cola demo.q (con DLQ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rabbit/queues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rabbit",
                "queues"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"demo.q\",\n  \"durable\": true,\n  \"deadLetterExchange\": \"andesstay.dlx\",\n  \"deadLetterRoutingKey\": \"demo.dlq\",\n  \"messageTtlMs\": 60000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Crear binding demo.direct -> demo.q",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
