                "exec": [
                  "pm.test(\"Responde 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Eliminar exchange demo.direct",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rabbit/exchanges/demo.direct",
              "host": [
                "{{baseUrl}}"
