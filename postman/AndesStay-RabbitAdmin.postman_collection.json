            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exchange\": \"demo.direct\",\n  \"destination\": \"demo.q\",\n  \"destinationType\": \"QUEUE\",\n  \"routingKey\": \"demo.key\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });"
                ]
